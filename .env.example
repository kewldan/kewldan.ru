# Скопировать в .env на сервере (/root/kewldan.ru/.env).

# Домен сайта; Traefik выпускает сертификат через myresolver.
DOMAIN=kewldan.ru

# Bearer-токен для /api/admin/*: правка Watched, перечитать контент, очистить доску.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

TZ=Europe/Moscow

# Живая статистика (необязательно, обновляется раз в 6 часов).
# GitHub: fine-grained токен только на чтение, с доступом ко всем репозиториям
# (Metadata: read) — даёт контрибьюшены и число приватных репозиториев.
GITHUB_TOKEN=
# Steam: ключ с https://steamcommunity.com/dev/apikey и SteamID64 профиля
# (профиль и список игр должны быть открыты).
STEAM_API_KEY=
STEAM_ID=
